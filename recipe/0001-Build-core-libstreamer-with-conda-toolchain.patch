+# The upstream WORKSPACE registers a devcontainer-specific Bazel crosstool
+# (expecting /usr/bin/<arch>-linux-gnu-gcc) and pulls in pre-built third-party
+# SDKs from /opt and /usr/local/cuda. This recipe builds only the core
+# libstreamer.so against the conda-forge host environment, so:
+#
+#   * the crosstool registration is dropped, which lets Bazel auto-detect the
+#     conda-forge compiler through CC/CXX;
+#   * the object-storage backends (s3/gcs/azure) ship as separate Python wheels
+#     (runai_model_streamer_{s3,gcs,azure}) that dlopen their own .so files, so
+#     neither their local repositories (path "/opt") nor google-cloud-cpp
+#     (loaded from the network, needs the crosstool above) are needed here;
+#   * the cuda/uring/aio headers come from the conda prefix (cuda-cudart-dev,
+#     liburing, libaio) instead of the devcontainer image. build.sh populates
+#     .bazel-deps/<name>/include with symlinks into the prefix, which keeps the
+#     upstream BUILD files referencing these repositories unchanged.
 new_local_repository(
     name = "cuda",
-    path = "/usr/local/cuda",
+    path = ".bazel-deps/cuda",
     build_file = "//third_party:cuda.BUILD"
 )
 
-new_local_repository(
-    name = "aws",
-    path = "/opt",
-    build_file = "//third_party:aws.BUILD"
-)
-
-new_local_repository(
-    name = "azure",
